# Copy to .env to override. Defaults target the local Ollama install.

# ── Brain ─────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, a hosted API).
AURA_BASE_URL=http://localhost:11434/v1
AURA_API_KEY=ollama
AURA_MODEL=gemma4:26b
# none | low | medium | high. "none" = fastest replies. Leave empty to omit for servers that reject it.
AURA_REASONING_EFFORT=none
# Must match the CONTEXT column of `ollama ps`. Aura compacts its memory at 60% of this.
AURA_CONTEXT_TOKENS=16384

# ── Hands ─────────────────────────────────────────────────────────────────────
# The only folder the file tools can touch (created on first run).
AURA_VAULT_DIR=~/Documents/Aura_Vault
# Web search. Without a key (or if Tavily fails) Aura falls back to DuckDuckGo.
TAVILY_API_KEY=
# Code interpreter (Docker must be running). The default image is built on first use.
AURA_SANDBOX_IMAGE=aura-sandbox:1
AURA_SANDBOX_TIMEOUT=30
# Append-only log of approvals, file changes, code runs and blocked paths.
AURA_AUDIT_LOG=~/Library/Logs/Aura/actions.jsonl
