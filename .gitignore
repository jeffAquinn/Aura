# Secrets. Aura keeps keys and connection credentials in the macOS Keychain (Settings), never
# in files; these patterns stop a downloaded credential file from ever being committed.
.env
.env.*
!.env.example
client_secret*.json
*.apps.googleusercontent.com.json
credentials*.json
token*.json
*.pem
*.p12
*.key

# Python
__pycache__/
*.py[cod]
*.class
venv/
.venv/
.pytest_cache/

# Environment/System
.DS_Store
.env.local

# Logs
*.log

# IDEs
.vscode/
.idea/

# Swift app build output
app/.build/
app/build/

# Sprint 5: staging worktrees (shadow projects)
.aura-staging/
